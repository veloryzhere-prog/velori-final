# ==========================================
# VELORI NOTIFICATION CONFIGURATION
# Provider: OneSignal
# Backend: Supabase Edge Functions
# ==========================================

# PUBLIC APPLICATION IDENTIFIER
ONESIGNAL_APP_ID=86e2e54e-2c25-49cb-97e5-f64030ac74b9

# PRIVATE SERVER-SIDE CREDENTIAL
ONESIGNAL_REST_API_KEY=YOUR_ONESIGNAL_REST_API_KEY

# PRIVATE ES256 IDENTITY VERIFICATION KEY (PEM)
ONESIGNAL_IDENTITY_VERIFICATION_SECRET_KEY=YOUR_ONESIGNAL_IDENTITY_VERIFICATION_SECRET_KEY

# WEB PUSH (VAPID)
# Public key may also be set as VITE_VAPID_PUBLIC_KEY for browser subscription.
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
# Keep the PKCS8 private key server-side only; never use a VITE_ variable.
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_PEM
VAPID_SUBJECT=mailto:push@veloryz.online

# SUPABASE SERVER CONFIGURATION
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OPTIONAL NOTIFICATION SETTINGS
NOTIFICATION_DEFAULT_CHANNEL=general
NOTIFICATION_RATE_LIMIT=YOUR_CONFIGURED_LIMIT
NOTIFICATION_DEBUG=false
