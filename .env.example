# VELORI public browser configuration.
# Use the values from the Supabase project that actually hosts your VELORI data.
# Only publishable / legacy anon keys belong in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional web-push public key. Leave blank unless web push is configured.
VITE_VAPID_PUBLIC_KEY=

# Optional feature configuration.
VITE_STUDIO_ENABLED=true
VITE_FORGE_BROWSER_RUNTIME_LICENSED=false
